<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Directory.Packages.props is imported BEFORE Directory.Build.props, so the contracts version
      has to be defaultable here for the PackageVersion items below to expand. src/Directory.Build.props
      carries the same conditional default; whichever file evaluates second sees a non-empty value
      and leaves it alone, and -p:SRTContractsVersion= overrides both.
    -->
    <SRTContractsVersion Condition="'$(SRTContractsVersion)'==''">5.0.0-alpha.4</SRTContractsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The contracts packages. Added by src/Directory.Build.targets through the SRTReferenceContracts /
      SRTReferenceAbstractions opt-ins (deviation 4), so they never appear in a csproj; the targets
      reference them without a Version and this file owns it. SRTUseLocalContracts=true swaps both for
      ProjectReferences and bypasses these entries entirely.
    -->
    <PackageVersion Include="SRTPluginBase" Version="$(SRTContractsVersion)" />
    <PackageVersion Include="SRTPluginBase.Abstractions" Version="$(SRTContractsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="Avalonia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Win32" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Skia" Version="12.2.0" />
    <!-- Skia rasterises glyphs; it does not shape text. Without this, Setup() throws. -->
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <!-- The plugin list is a grid of columns a user sorts and resizes; this is that control. -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
  <!--
    Pinned to the SDK's own band (10.0.4xx), and it has to stay at a patched version.

    CVE-2026-62900 / GHSA-23fw-v26w-5fgq is in the transitive Microsoft.Build.Tasks.Git and covers
    8.0.0, 10.0.102-10.0.110, 10.0.200-10.0.204 and 10.0.300-10.0.301; the fixes are 10.0.111 and
    10.0.303, and the 10.0.2xx band was never patched. NuGet audit reports it as NU1902, which is an
    error here because TreatWarningsAsErrors is on - so a build failing on this means the pin has
    fallen into an affected range, not that the package should be dropped.

    The .NET SDK has carried SourceLink in-box since 8.0 and suppresses its own copy whenever a
    Microsoft.SourceLink.* package is referenced, which is why the package still ships and still
    gets 10.x releases per SDK band (and 11.x previews): the SDK ingests those packages, and a
    build that is not using the .NET SDK, or is on an SDK older than its repo needs, still
    references them directly. Keeping the reference means the version is stated here rather than
    inherited from whichever SDK happens to be installed.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)'!='.wixproj'">
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </GlobalPackageReference>
  </ItemGroup>
</Project>