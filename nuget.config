<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local output of the sibling SRTPluginBase repo. Present so a contracts change can be packed
      next door and consumed here without publishing to nuget.org first. Harmless when the folder
      does not exist. The alternative path - building against the sibling sources directly - is
      -p:SRTUseLocalContracts=true, see src/Directory.Build.props.

      This file lives at the repository root rather than in src/ because NuGet resolves its settings
      per project directory, not per solution: tests/ sits outside src/ and so never saw a config
      kept there, which made the test projects restore the contracts from nuget.org while the src/
      projects restored them from this feed.
    -->
    <add key="srtpluginbase-local" value="..\SRTPluginBase\artifacts" />
  </packageSources>
</configuration>
