<Project>
	<PropertyGroup>
		<TargetFramework Condition="'$(MSBuildProjectExtension)'=='.csproj'">net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<Authors>SpeedRunTool</Authors>
		<Company>$(Authors)</Company>
		<CopyrightYear>$([System.DateTime]::UtcNow.ToString("yyyy"))</CopyrightYear>
		<Copyright>Copyright © $(CopyrightYear) $(Company)</Copyright>
		<RepositoryUrl>https://github.com/$(Company)/SRTHost</RepositoryUrl>
		<Version>1.0.0+0</Version>
		<ProductVersion>1.0.0+0</ProductVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
	</PropertyGroup>

	<!--
	  Give $(Platform) a value before anything below consumes it.

	  Directory.Build.props is imported before the SDK applies its own AnyCPU default, so on a direct
	  `dotnet build some.csproj` the OutputPath and DefineConstants below would expand $(Platform) to
	  an empty string - putting output in bin\Debug
et10.0 instead of bin\Debug\AnyCPU
et10.0 and
	  silently dropping the platform compile constant. Building through the solution passes Platform
	  as a global property and does not hit it, so the two entry points would otherwise disagree and
	  you would find yourself running a stale binary.
	-->
	<PropertyGroup>
		<Platform Condition="'$(Platform)'==''">AnyCPU</Platform>
	</PropertyGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DebugType>portable</DebugType>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PublishProtocol>FileSystem</PublishProtocol>
		<OutputPath>bin\$(Configuration)\$(Platform)</OutputPath>
		<!-- PublishDir lives in Directory.Build.targets; see the note there. -->
		<DefineConstants>$(DefineConstants);$(Platform)</DefineConstants>
	</PropertyGroup>

	<!--
	  5.0 publishes everything framework-dependent, loose, un-bundled and un-precompiled.

	  ReadyToRun is deliberately OFF. It bought startup time the product never spends - the host and
	  its plugins are launched once alongside a game and left running for hours - and it was the sole
	  reason the 3.x host needed PublishReadyToRunExclude on its shared contract assembly: R2R rewrites
	  an assembly into an architecture-specific image, so one shared copy could only ever be valid for
	  one of the two runners. With R2R off, every managed assembly emitted here is plain AnyCPU IL and
	  byte-identical from the x64 and x86 legs, which is what lets both publish into one directory.

	  Single-file is off for the same reason it is no longer needed: nothing has to be hidden from the
	  shared directory, and SRTPluginBase.Abstractions.dll must stay loose so plugin authors can
	  reference the exact assembly the runner loads.
	-->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.csproj'">
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<!--
	  SRTHostSetup's wixproj files live under src/ too, so they inherit everything above. WiX maps
	  DebugType onto its -pdbType switch, which only accepts full or none - 'portable' is a hard
	  error (WIX0268). SourceLink has nothing to embed in an MSI or a bundle either, and the C#
	  analyzer settings below are meaningless to it.
	-->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.wixproj'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.csproj'">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!--
	  Contracts come from nuget.org by default. Set SRTUseLocalContracts=true (property or env var)
	  to build against a sibling clone of SpeedRunTool/SRTPluginBase instead.

	  This is deliberately NOT keyed off $(Configuration): Issue/35 tied the ProjectReference to Debug
	  and the PackageReference to Release, which silently made the two configurations compile against
	  different code. Opting in explicitly keeps them in agreement unless you say otherwise.
	-->
	<PropertyGroup>
		<SRTUseLocalContracts Condition="'$(SRTUseLocalContracts)'==''">false</SRTUseLocalContracts>
		<SRTContractsVersion>5.0.0-alpha.1</SRTContractsVersion>
		<SRTContractsPath>$(MSBuildThisFileDirectory)..\..\SRTPluginBase\src\</SRTContractsPath>
	</PropertyGroup>

	<ItemGroup Condition="'$(MSBuildProjectExtension)'!='.wixproj'">
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
