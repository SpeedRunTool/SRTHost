<Project>

	<!--
	  PublishDir has to be set here rather than in Directory.Build.props.

	  Directory.Build.props is imported before the project body, so $(TargetFramework) is not set
	  yet and the segment would silently expand to nothing. Directory.Build.targets is imported
	  after the body, so the TFM is known here.

	  OutputPath does not have this problem and stays in the .props: the SDK appends the TFM and RID
	  to OutputPath itself. It does not do that for PublishDir.

	  Note there is deliberately no $(Platform) segment, unlike OutputPath. Every project publishes
	  into ONE directory, which is the layout the installer and the release zip both want. The three
	  executables have distinct names (SRTHost.exe / SRTHost.PluginRunner64.exe /
	  SRTHost.PluginRunner32.exe), and the files the x64 and x86 runner legs DO share -
	  SRTPluginBase.Abstractions.dll, SRTHost.Ipc.dll, SRTHost.Core.dll and their .pdb files - are
	  plain AnyCPU IL and byte-identical from either leg, because ReadyToRun is off everywhere
	  (see Directory.Build.props). Builds still go to separate per-Platform directories via
	  OutputPath; it is only publish that converges.

	  That byte-identical property is load-bearing and spans several files, so CI enforces it: the
	  package job fails if merging the two matrix artifacts would overwrite any file with differing
	  content. If you ever add a native or RID-specific asset to the runner, this invariant breaks
	  and the guard is what will tell you.
	-->
	<PropertyGroup>
		<PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
	</PropertyGroup>

	<!--
	  Contract references have to be resolved HERE, not in Directory.Build.props.

	  A project opts in with <SRTReferenceContracts>true</SRTReferenceContracts> in its own body, and
	  .props is imported before that body runs - so the condition would always read an empty string
	  and silently reference nothing. .targets is imported afterwards, when the property is set.
	  NuGet restore evaluates the project fully, so items introduced here are still restored.

	  SRTUseLocalContracts=true swaps the package for the sibling repo's sources; see the note in
	  Directory.Build.props.
	-->
	<Choose>
		<When Condition="'$(SRTReferenceContracts)'=='true' AND '$(SRTUseLocalContracts)'=='true'">
			<ItemGroup>
				<ProjectReference Include="$(SRTContractsPath)SRTPluginBase.Abstractions\SRTPluginBase.Abstractions.csproj" />
				<ProjectReference Include="$(SRTContractsPath)SRTPluginBase\SRTPluginBase.csproj" />
			</ItemGroup>
		</When>
		<When Condition="'$(SRTReferenceContracts)'=='true'">
			<ItemGroup>
				<PackageReference Include="SRTPluginBase" Version="$(SRTContractsVersion)" />
			</ItemGroup>
		</When>

		<!--
		  Abstractions on its own, for the host's own assemblies rather than for plugins.

		  SRTHost.Ipc puts PluginStatus, PluginSubStatus, PluginArchitecture and PayloadCodec on the
		  wire; they are contract types and must not be redeclared here, because a second copy of an
		  enum whose numeric values are a wire format is a silent drift waiting to happen.

		  It is deliberately NOT <SRTReferenceContracts>. That pulls in SRTPluginBase, the base classes
		  plugin authors derive from, which brings Microsoft.Extensions.* along and - because the
		  manifest generator treats a direct SRTPluginBase reference as "this project is a plugin" -
		  would fail the build with SRT1001 for want of a [SrtPluginAssembly]. Abstractions is
		  deliberately excluded from that detection for exactly this case: the host implements the
		  other side of the contract.
		-->
		<When Condition="'$(SRTReferenceAbstractions)'=='true' AND '$(SRTUseLocalContracts)'=='true'">
			<ItemGroup>
				<ProjectReference Include="$(SRTContractsPath)SRTPluginBase.Abstractions\SRTPluginBase.Abstractions.csproj" />
			</ItemGroup>
		</When>
		<When Condition="'$(SRTReferenceAbstractions)'=='true'">
			<ItemGroup>
				<PackageReference Include="SRTPluginBase.Abstractions" Version="$(SRTContractsVersion)" />
			</ItemGroup>
		</When>
	</Choose>

	<!--
	  The srtplugin.json generator rides along in the SRTPluginBase package's buildTransitive/ folder,
	  so the PackageReference branch above gets it for free. A ProjectReference carries no build
	  targets, so the local-contracts branch has to import the same file by hand and point the
	  UsingTask at the task project's build output instead of the tasks/ folder a package would have.

	  Without this, a -p:SRTUseLocalContracts=true build would silently stop emitting manifests, and
	  the host would stop seeing its own demo plugins - the exact kind of Debug-versus-Release
	  divergence the SRTReferenceContracts opt-in exists to prevent.
	-->
	<PropertyGroup Condition="'$(SRTReferenceContracts)'=='true' AND '$(SRTUseLocalContracts)'=='true'">
		<_SrtLocalBuildTasksTfm Condition="'$(MSBuildRuntimeType)'=='Core'">net10.0</_SrtLocalBuildTasksTfm>
		<_SrtLocalBuildTasksTfm Condition="'$(_SrtLocalBuildTasksTfm)'==''">net48</_SrtLocalBuildTasksTfm>
		<SrtBuildTasksAssembly>$(SRTContractsPath)SRTPluginBase.BuildTasks\bin\$(Configuration)\$(_SrtLocalBuildTasksTfm)\SRTPluginBase.BuildTasks.dll</SrtBuildTasksAssembly>
	</PropertyGroup>

	<Import Project="$(SRTContractsPath)SRTPluginBase\buildTransitive\SRTPluginBase.props"
	        Condition="'$(SRTReferenceContracts)'=='true' AND '$(SRTUseLocalContracts)'=='true'" />
	<Import Project="$(SRTContractsPath)SRTPluginBase\buildTransitive\SRTPluginBase.targets"
	        Condition="'$(SRTReferenceContracts)'=='true' AND '$(SRTUseLocalContracts)'=='true'" />

	<!--
	  A plugin project's output has to be self-contained, so its package dependencies are copied
	  beside it.

	  The SDK defaults CopyLocalLockFileAssemblies to false for a library, on the reasonable grounds
	  that whatever consumes the library will resolve its packages itself. A plugin has no such
	  consumer: it is loaded out of a directory by a runner that knows nothing about NuGet, so
	  anything not in that directory has to come from the runner's own closure or it does not resolve
	  at all. Without this, SRTPluginBase.dll is absent from every plugin folder and every plugin
	  fails to load with a FileNotFoundException naming the base class it derives from.

	  Note this also drops Microsoft.Extensions.*.Abstractions.dll into the folder. That is expected,
	  and it is exactly the case PluginLoadContext's shared-assembly list exists for: those load from
	  the runner's own context so the types stay reference-identical across the boundary.
	-->
	<PropertyGroup Condition="'$(SRTReferenceContracts)'=='true' AND '$(CopyLocalLockFileAssemblies)'==''">
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<!--
	  Deploy a plugin into the host's plugins folder as part of building it.

	  Opt in with <SRTDeployAsPlugin>true</SRTDeployAsPlugin>. This is the same arrangement the
	  out-of-repo plugin repositories use - they build straight into the host's output through a
	  relative path - so the in-repo demo plugins exercise the real convention rather than a
	  convenience that only exists here.

	  The layout written is plugins\<AssemblyName>\, holding the plugin, its private dependencies,
	  its .deps.json and the generated srtplugin.json. Including the .deps.json is deliberate: it is
	  what the runner's AssemblyDependencyResolver reads, so this exercises the resolver path, while
	  the runner's own test harness stages a folder without one to exercise the root-probe fallback.
	  Both are real ways a plugin folder arrives on disk.

	  It runs after Build rather than after the manifest target and takes srtplugin.json from
	  $(TargetDir), so it copies whatever that build produced - a manifest that failed to generate is
	  a missing file here rather than a stale one silently redeployed.
	-->
	<Target Name="SrtDeployPlugin" AfterTargets="Build" Condition="'$(SRTDeployAsPlugin)'=='true'">
		<PropertyGroup>
			<SrtHostPluginsDir Condition="'$(SrtHostPluginsDir)'==''">$(MSBuildThisFileDirectory)SRTHost\bin\$(Configuration)\AnyCPU\$(TargetFramework)\plugins\$(AssemblyName)\</SrtHostPluginsDir>
		</PropertyGroup>

		<ItemGroup>
			<_SrtPluginPayload Include="$(TargetDir)*.dll" />
			<_SrtPluginPayload Include="$(TargetDir)*.pdb" />
			<_SrtPluginPayload Include="$(TargetDir)$(AssemblyName).deps.json" />
			<_SrtPluginPayload Include="$(TargetDir)srtplugin.json" />
		</ItemGroup>

		<Copy SourceFiles="@(_SrtPluginPayload)" DestinationFolder="$(SrtHostPluginsDir)" SkipUnchangedFiles="true" />

		<Message Importance="normal" Text="Deployed $(AssemblyName) to $(SrtHostPluginsDir)" />
	</Target>

</Project>
