<Project>

	<!--
	  PublishDir has to be set here rather than in Directory.Build.props.

	  Directory.Build.props is imported before the project body, so $(TargetFramework) is not set
	  yet and the segment would silently expand to nothing. Directory.Build.targets is imported
	  after the body, so the TFM is known here.

	  OutputPath does not have this problem and stays in the .props: the SDK appends the TFM and RID
	  to OutputPath itself. It does not do that for PublishDir.

	  Note there is deliberately no $(Platform) segment, unlike OutputPath. Every project publishes
	  into ONE directory, which is the layout the installer and the release zip both want. The three
	  executables have distinct names (SRTHost.exe / SRTHost.PluginRunner64.exe /
	  SRTHost.PluginRunner32.exe), and the files the x64 and x86 runner legs DO share -
	  SRTPluginBase.Abstractions.dll, SRTHost.Ipc.dll, SRTHost.Core.dll and their .pdb files - are
	  plain AnyCPU IL and byte-identical from either leg, because ReadyToRun is off everywhere
	  (see Directory.Build.props). Builds still go to separate per-Platform directories via
	  OutputPath; it is only publish that converges.

	  That byte-identical property is load-bearing and spans several files, so CI enforces it: the
	  package job fails if merging the two matrix artifacts would overwrite any file with differing
	  content. If you ever add a native or RID-specific asset to the runner, this invariant breaks
	  and the guard is what will tell you.
	-->
	<PropertyGroup>
		<PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
	</PropertyGroup>

	<!--
	  Contract references have to be resolved HERE, not in Directory.Build.props.

	  A project opts in with <SRTReferenceContracts>true</SRTReferenceContracts> in its own body, and
	  .props is imported before that body runs - so the condition would always read an empty string
	  and silently reference nothing. .targets is imported afterwards, when the property is set.
	  NuGet restore evaluates the project fully, so items introduced here are still restored.

	  SRTUseLocalContracts=true swaps the package for the sibling repo's sources; see the note in
	  Directory.Build.props.
	-->
	<Choose>
		<When Condition="'$(SRTReferenceContracts)'=='true' AND '$(SRTUseLocalContracts)'=='true'">
			<ItemGroup>
				<ProjectReference Include="$(SRTContractsPath)SRTPluginBase.Abstractions\SRTPluginBase.Abstractions.csproj" />
				<ProjectReference Include="$(SRTContractsPath)SRTPluginBase\SRTPluginBase.csproj" />
			</ItemGroup>
		</When>
		<When Condition="'$(SRTReferenceContracts)'=='true'">
			<ItemGroup>
				<PackageReference Include="SRTPluginBase" Version="$(SRTContractsVersion)" />
			</ItemGroup>
		</When>
	</Choose>

</Project>
