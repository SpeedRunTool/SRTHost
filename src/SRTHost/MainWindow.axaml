<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SRTHost.MainWindow"
        Title="SRT Host"
        Width="960" Height="600"
        WindowStartupLocation="CenterScreen">

  <StackPanel Margin="24" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="SRT Host" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <TextBlock Name="StatusText" Opacity="0.7" HorizontalAlignment="Center" />
  </StackPanel>

</Window>
