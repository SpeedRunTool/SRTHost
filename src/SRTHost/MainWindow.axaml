<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SRTHost.ViewModels"
        x:Class="SRTHost.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/SRT.ico"
        Title="SRT Host"
        Width="1100" Height="700"
        MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="180,*">

    <!--
      The nav rail binds to the page list itself rather than to a hardcoded set of buttons, so adding
      a page is one line in MainWindowViewModel and nothing here.
    -->
    <ListBox Grid.Row="0" Grid.Column="0"
             Margin="8"
             ItemsSource="{Binding Pages}"
             SelectedItem="{Binding CurrentPage}"
             BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ViewModelBase">
          <TextBlock Text="{Binding Title}" Padding="4,6" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="0" Grid.Column="1" Margin="0,8,8,0">
      <ContentControl Content="{Binding CurrentPage}" />
    </Border>

    <Border Grid.Row="1" Grid.ColumnSpan="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Padding="10,5">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding LatencyText}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Grid.Column="3" Text="{Binding VersionText}" Opacity="0.5" VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>

</Window>
