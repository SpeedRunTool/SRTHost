@page "/Debug"
@inject NavigationManager navigationManager;
@inject IHttpClientFactory httpClientFactory;
<PageTitle>Debug</PageTitle>

<Container>
    <MudPaper Class="w-full h-full flex-col gap-4 rounded-none">
        <PageHeader>
            <MudText Typo="Typo.h5">Debug</MudText>
            <MudSpacer />
            <MudHidden Breakpoint="Breakpoint.Xs">
                <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
                    <MudButton OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Plugin", UriKind.Relative)))">
                        Loaded Plugins
                    </MudButton>
                    <MudButton OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Debug/GenerateMainJson", UriKind.Relative)))">
                        Debug Main
                    </MudButton>
                    <MudButton OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Debug/GenerateManifestHost", UriKind.Relative)))">
                        Debug Manifest Host
                    </MudButton>
                    <MudButton OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Debug/GenerateManifestPlugin", UriKind.Relative)))">
                        Debug Manifest Plugin
                    </MudButton>
                </MudButtonGroup>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Plugin", UriKind.Relative)))">
                    Loaded Plugins
                </MudButton>
                <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Debug/GenerateMainJson", UriKind.Relative)))">
                    Debug Main
                </MudButton>
                <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Debug/GenerateManifestHost", UriKind.Relative)))">
                    Debug Manifest Host
                </MudButton>
                <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("GET", new Uri("/api/v1/Debug/GenerateManifestPlugin", UriKind.Relative)))">
                    Debug Manifest Plugin
                </MudButton>
            </MudHidden>
        </PageHeader>
        @responsePageString<br />
        @foreach ((PluginStateValue<IPlugin> pluginStateValue, int index) in pluginHost.LoadedPlugins.Values.Select((psv, i) => (psv, i)))
        {
            <PluginBar>
                <PluginHeader>
                    <MudAvatar Color="@SRTHost.Helpers.GetRunningStatusColor(pluginStateValue)" Variant="Variant.Filled">
                        <MudIcon Color="Color.Dark" Icon="@SRTHost.Helpers.GetRunningStatusIcon(pluginStateValue)" />
                    </MudAvatar>
                    <PluginTitle>
                        @pluginStateValue.PluginType?.Name
                    </PluginTitle>
                </PluginHeader>
                <MudHidden Breakpoint="Breakpoint.Xs">
                    <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
                        <MudButton OnClick="@((e) => RequestAsString("GET", new Uri($"/api/v1/Plugin/{pluginStateValue.PluginType?.Name ?? "Unknown"}/Info", UriKind.Relative)))">
                            Info
                        </MudButton>
                        @if (pluginStateValue.Plugin! is IPluginProducer)
                        {
                            <MudButton OnClick="@((e) => RequestAsString("GET", new Uri($"/api/v1/Plugin/{pluginStateValue.PluginType?.Name ?? "Unknown"}/Data", UriKind.Relative)))">
                                Data
                            </MudButton>
                        }
                        <MudButton OnClick="@((e) => RequestAsString("GET", new Uri($"/api/v1/Plugin/{pluginStateValue.PluginType?.Name ?? "Unknown"}/GenerateManifest", UriKind.Relative)))">
                            Generate Manifest
                        </MudButton>
                    </MudButtonGroup>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                    <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("GET", new Uri($"/api/v1/Plugin/{pluginStateValue.PluginType?.Name ?? "Unknown"}/Info", UriKind.Relative)))">
                        Info
                    </MudButton>
                    @if (pluginStateValue.Plugin! is IPluginProducer)
                    {
                        <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("GET", new Uri($"/api/v1/Plugin/{pluginStateValue.PluginType?.Name ?? "Unknown"}/Data", UriKind.Relative)))">
                            Data
                        </MudButton>
                    }
                    <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("GET", new Uri($"/api/v1/Plugin/{pluginStateValue.PluginType?.Name ?? "Unknown"}/GenerateManifest", UriKind.Relative)))">
                        Generate Manifest
                    </MudButton>
                </MudHidden>
            </PluginBar>
        }
    </MudPaper>
</Container>

@code
{
    private HttpStatusCode responseCode;
    private string? responseMessage;

    private string responsePageString => (int)responseCode != 0 ? $"{responseMessage} (HTTP {(int)responseCode} ({responseCode.ToString()}))" : string.Empty;

    private async Task RequestAsString(string method, Uri requestUri, string acceptHeader = "application/json", HttpContent? httpContent = default)
    {
        using (HttpClient httpClient = httpClientFactory.CreateClient().ConfigureHttpClient(baseUri: !requestUri.IsAbsoluteUri ? new Uri(navigationManager.BaseUri, UriKind.Absolute) : null, acceptHeader))
        using (HttpResponseMessage httpResponseMessage = await httpClient.Request(method, requestUri, httpContent))
        {
            responseCode = httpResponseMessage.StatusCode;
            responseMessage = await httpResponseMessage.Content.ReadAsStringAsync();
        }
    }
}