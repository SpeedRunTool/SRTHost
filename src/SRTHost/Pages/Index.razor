@page "/"
@inject NavigationManager navigationManager;
@inject IHttpClientFactory httpClientFactory;
<PageTitle>Home</PageTitle>

<div class="w-full h-full">
    @if (pluginHost is null)
    {
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="w-full h-full flex-col gap-4 rounded-none">
            <PageHeader>
                <MudText Typo="Typo.h5">Plugins</MudText>
                <MudSpacer />
                <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("POST", new Uri("/api/v1/Plugin/ReloadAll", UriKind.Relative)))">
                    Reload Plugins
                </MudButton>
            </PageHeader>
            @responsePageString<br />
            @foreach ((PluginStateValue<IPlugin> pluginStateValue, int index) in pluginHost.LoadedPlugins.Values.Select((psv, i) => (psv, i)))
            {
                <PluginBar>
                    <PluginHeader>
                        <MudAvatar Color="@SRTHost.Helpers.GetRunningStatusColor(pluginStateValue)" Variant="Variant.Filled">
                            <MudTooltip Text="@pluginStateValue.Status.ToString()">
                                <MudIcon Color="Color.Dark" Icon="@SRTHost.Helpers.GetRunningStatusIcon(pluginStateValue)" />
                            </MudTooltip>
                        </MudAvatar>
                        <PluginTitle>
                            @(pluginStateValue.Plugin?.Info.Name ?? $"Unknown Plugin: {(pluginStateValue.PluginType?.Assembly.Location ?? "Unknown Path")}")<br />
                            @((pluginStateValue.Plugin is not null) ? pluginStateValue.Plugin!.Info.Version : "Unknown Version")
                        </PluginTitle>
                    </PluginHeader>
                    <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="@((e) => RequestAsString("POST", new Uri($"/api/v1/Plugin/{pluginStateValue.PluginType?.Name ?? "Unknown"}/Reload", UriKind.Relative)))">
                        Reload
                    </MudButton>
                </PluginBar>
            }
        </MudPaper>
    }
</div>

@code
{
    private HttpStatusCode responseCode;
    private string? responseMessage;

    private string responsePageString => (int)responseCode != 0 ? $"{responseMessage} (HTTP {(int)responseCode} ({responseCode.ToString()}))" : string.Empty;

    private async Task RequestAsString(string method, Uri requestUri, HttpContent? httpContent = default)
    {
        using (HttpClient httpClient = httpClientFactory.CreateClient().ConfigureHttpClient(baseUri: !requestUri.IsAbsoluteUri ? new Uri(navigationManager.BaseUri, UriKind.Absolute) : null, "text/plain"))
        using (HttpResponseMessage httpResponseMessage = await httpClient.Request(method, requestUri, httpContent))
        {
            responseCode = httpResponseMessage.StatusCode;
            responseMessage = await httpResponseMessage.Content.ReadAsStringAsync();
        }
    }
}