<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<Platforms>x64;x86</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<Product>SRT Host</Product>
		<Description>A plugin host for various informational SpeedRun Tools.</Description>
		<PackageId>SRTHost</PackageId>
		<PackageDescription>$(Description)</PackageDescription>
		<Version>1.0.0</Version>
		<FileVersion>1.0.0</FileVersion>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)'=='x64'">
		<AssemblyName>SRTHost64</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)'=='x86'">
		<AssemblyName>SRTHost32</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
	  <Content Remove="appsettings.Development.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7">
			<ExcludeAssets>Compile;Build</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
	</ItemGroup>

	<Choose>
		<When Condition="'$(Configuration)'=='Debug'">
			<ItemGroup>
				<ProjectReference Include="..\..\..\SRTPluginBase\src\SRTPluginBase\SRTPluginBase.csproj" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<PackageReference Include="SRTPluginBase" Version="5.0.0-*" />
			</ItemGroup>
		</Otherwise>
	</Choose>

	<!-- Exclude SRTPluginBase.dll from single-file bundle -->
	<Target Name="ExcludeSRTPluginBaseFromSingleFile"
			BeforeTargets="GenerateSingleFileBundle"
			Condition="'$(PublishSingleFile)' == 'true'">

		<ItemGroup>
			<_SRTPluginBaseFiles
				Include="@(FilesToBundle)"
				Condition="'%(Filename)' == 'SRTPluginBase'" />
		</ItemGroup>

		<ItemGroup>
			<FilesToBundle
				Remove="@(_SRTPluginBaseFiles)" />
		</ItemGroup>

		<Message
			Importance="high"
			Text="ExcludeSRTPluginBaseFromSingleFile: removed SRTPluginBase files from single-file bundle." />
	</Target>

	<Target Name="CopySRTPluginBaseToPublishDir"
			AfterTargets="Publish"
			Condition="'$(PublishSingleFile)' == 'true'">

		<Copy SourceFiles="@(_SRTPluginBaseFiles)"
			  DestinationFolder="$(PublishDir)"
			  SkipUnchangedFiles="true" />

		<Message
			Importance="high"
			Text="CopySRTPluginBaseToPublishDir: copied SRTPluginBase files to $(PublishDir)." />
	</Target>

</Project>
