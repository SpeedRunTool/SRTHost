<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <Platforms>x64;x86</Platforms>
    <Product>SRT Host</Product>
    <Description>A plugin-based application for running various informational speedrun tools.</Description>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <AssemblyName>$(AssemblyName)64</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <AssemblyName>$(AssemblyName)32</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host guarantees the ASP.NET Core shared framework is available so plugins may use
         ASP.NET assets. The installer chains the ASP.NET Core runtime to satisfy this. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRTPluginBase\SRTPluginBase.csproj" />
  </ItemGroup>
  
</Project>
