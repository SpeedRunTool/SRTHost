{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "HttpEndpoint": {
        "Url": "http://*:7190",
        "Protocols": "Http1"
      },
      "HttpsEndpoint": {
        "Url": "https://*:7191",
        "Protocols": "Http1AndHttp2AndHttp3",
        "Certificate": {
          "Subject": "localhost",
          "Store": "My",
          "Location": "CurrentUser",
          "AllowInvalid": true
        },
        "ClientCertificateMode": "NoCertificate"
      }
    }
  }
}
