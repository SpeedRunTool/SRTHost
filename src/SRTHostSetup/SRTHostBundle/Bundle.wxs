<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <!--
    SRTHostSetup - the shippable installer.

    It chains the .NET prerequisites and the per-user SRT Host MSI. The runtime payloads are
    NOT embedded (Compressed="no" on each ExePackage), so this executable stays around 1 MB and
    only downloads a runtime when one is actually missing.

    Version is the full four-field product version. Burn compares all four fields when detecting
    a related bundle, so 1.0.0.0 -> 1.0.0.1 upgrades correctly here even though the MSI inside
    can only express 1.0.0. See Version.props.
  -->
  <Bundle Name="SRT Host"
          Manufacturer="$(Manufacturer)"
          Version="$(ProductVersion)"
          UpgradeCode="1E925787-801C-4D19-9F29-456C1F1E74CC"
          AboutUrl="$(AboutUrl)"
          Compressed="yes"
          DisableModify="yes"
          IconSourceFile="..\..\assets\SRT.ico">

    <BootstrapperApplication>
      <!--
        hyperlinkSidebarLicense is the 600x450 two-pane theme: branded sidebar on the left,
        content on the right. The stock assets it expects are exact sizes and are NOT scaled
        gracefully on high-DPI displays, so match them:

          LogoSideFile  165x400 - Install, Modify, Success and Failure pages
          LogoFile       64x64  - Help, Options and Progress pages

        Both must be supplied or those pages fall back to the WiX Toolset logo.

        ThemeFile/LocalizationFile are verbatim copies of the extension's own
        HyperlinkSidebarTheme.xml and HyperlinkTheme.wxl, with one edit: Window/@IconFile.
        That attribute is the only way to set the installer window's title-bar and taskbar icon,
        and it cannot be reached without owning a copy of the theme. The copies are therefore
        pinned to WiX 5.0.2 - re-extract them from the wixext if the toolset is upgraded.
      -->
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkSidebarLicense"
          ThemeFile="assets\SRTHostTheme.xml"
          LocalizationFile="assets\SRTHostTheme.wxl"
          LogoSideFile="assets\logoside.png"
          LogoFile="assets\logo.png"
          LicenseUrl="https://github.com/SpeedRunTool/SRTHost/blob/main/LICENSE"
          SuppressOptionsUI="yes"
          ShowVersion="yes" />

      <!--
        The theme's Window/@IconFile sets the title-bar and taskbar icon, and it resolves against
        the BA payload directory - so the .ico has to travel with the BA, not just be a PE
        resource on the bundle. Bundle/@IconSourceFile above is a separate thing: that is what
        Explorer shows for SRTHostSetup.exe itself.
      -->
      <Payload SourceFile="..\..\assets\SRT.ico" Name="SRT.ico" />
    </BootstrapperApplication>

    <!--
      Shortcuts go to both the Start Menu and the Desktop by default. Either can be turned off:

        SRTHostSetup.exe DesktopShortcut=0
        SRTHostSetup.exe StartMenuShortcut=0

      These are passed through to the MSI below. The Install page also carries a checkbox for
      each: a theme Checkbox whose Name matches a Burn variable is two-way bound to it, so the
      controls in SRTHostTheme.xml and these declarations are the same two values. Both default
      to 1, so both boxes come up checked.
    -->
    <Variable Name="StartMenuShortcut" Value="1" Type="numeric" bal:Overridable="yes" />
    <Variable Name="DesktopShortcut" Value="1" Type="numeric" bal:Overridable="yes" />

    <Chain>
      <PackageGroupRef Id="NetRuntimePrerequisites" />

      <MsiPackage Id="SRTHost"
                  SourceFile="$(MsiPath)"
                  Compressed="yes"
                  Vital="yes">
        <MsiProperty Name="STARTMENUSHORTCUT" Value="[StartMenuShortcut]" />
        <MsiProperty Name="DESKTOPSHORTCUT" Value="[DesktopShortcut]" />
      </MsiPackage>
    </Chain>

  </Bundle>
</Wix>
